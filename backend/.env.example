# 값은 비워 두고 이름만 저장소에 둔다 (설계서 2.7.3). 실제 값은 .env 에 넣고 커밋하지 않는다.
ENV=local
DATABASE_URL=postgresql+psycopg://majunggil_app:CHANGE_ME@localhost:5432/majunggil
MIGRATION_DATABASE_URL=postgresql+psycopg://majunggil_owner:CHANGE_ME@localhost:5432/majunggil
ADMIN_KEY=
ALLOWED_ORIGINS=
DEFAULT_ARRIVAL_RADIUS_M=150
LOG_LEVEL=INFO
FRONTEND_DIR=
# 비우면 ENV 로 정함 (local → report-only, prod → enforce). report-only | enforce | off
CSP_MODE=
